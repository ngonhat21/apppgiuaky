{
  "rules": {
    ".read": false,
    ".write": false,
    "products": {
      ".read": "auth != null && auth.uid === 'REPLACE_WITH_ADMIN_UID'",
      "$id": {
        ".write": "auth != null && auth.uid === 'REPLACE_WITH_ADMIN_UID'",
        ".validate": "newData.hasChildren(['name', 'price', 'soluong', 'image'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120"
        },
        "price": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000000"
        },
        "soluong": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000 && newData.val() % 1 === 0"
        },
        "image": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 950000 && (newData.val().beginsWith('data:image/') || newData.val().beginsWith('https://'))"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
